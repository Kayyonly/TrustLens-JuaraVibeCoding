# AI_PROVIDER selects one server-side provider; there is no automatic cross-provider fallback.
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GROQ_API_KEY=
# Default vision-capable Groq model documented by Groq: qwen/qwen3.8-27b (preview access/quotas can change).
GROQ_MODEL=qwen/qwen3.8-27b

# VirusTotal URL scanner. Submitted URLs are shared with VirusTotal and may enter its community dataset.
# Public API limits and terms apply; verify that your use is permitted by your account tier/product use.
VIRUSTOTAL_API_KEY=
